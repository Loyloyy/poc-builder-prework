# ---- secrets / machine-specific (NEVER commit) ----
.env
.env.local

# ---- runtime outputs ----
# Run traces emitted by the harness (keep the dir, not the contents)
traces/*.json
# OpenAPI spec fetched from the live OpenCode server on-prem (ground truth, host-specific)
docs/openapi.json
# OpenCode local state / auth / real provider config (has the server IP + NFS model path).
# The committed template is docker/opencode.example.json; a real opencode.json is NEVER tracked.
.opencode/
opencode.json
opencode.json.local

# ---- python ----
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/

# ---- editor / os ----
.DS_Store
