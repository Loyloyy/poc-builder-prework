# ============================================================================
# poc-builder-prework — environment.  Copy to .env and fill in.  .env is GITIGNORED.
#
# ⚠️  This file is COMMITTED — keep it GENERIC. Put real model ids, hostnames, IPs,
#     ports and keys ONLY in the gitignored .env you create on the server.
# ============================================================================

# ---- Model endpoint: a DIRECT OpenAI-compatible endpoint. NO proxy (no LiteLLM). ----
# Either a self-hosted vLLM server, or a frontier provider's OpenAI-compatible API (or OpenRouter).
# OpenCode's build engine is pointed here via docker/opencode.example.json; the Phase-0 smoke test
# hits it directly. frontier<->vLLM swap (Phase 3) = change these three values, harness unchanged.
#   vLLM     : MODEL_API_BASE=http://host.docker.internal:<port>/v1   MODEL_API_KEY=not-needed
#              (vLLM accepts any non-empty key; the served id may have a LEADING SLASH — check
#               GET <base>/models -> data[0].id and use it EXACTLY.)
#   frontier : MODEL_API_BASE=https://openrouter.ai/api/v1            MODEL_API_KEY=<key>
MODEL_API_BASE=http://<model-host>:<port>/v1
# vLLM ignores the key but the OpenAI client wants a non-empty string — "not-needed" is fine.
MODEL_API_KEY=not-needed

# Model string AS THE ENDPOINT EXPOSES IT (look up the current one; do NOT hardcode an old id).
# For vLLM this is often the full served path and may have a LEADING SLASH — use it EXACTLY.
HARNESS_MODEL=<served-model-id>

# OpenCode splits provider/model. This MUST match the provider key you register in OpenCode's
# config (docker/opencode.example.json uses "vllm_api"). modelID = HARNESS_MODEL above.
OPENCODE_PROVIDER_ID=vllm_api

# ---- OpenCode headless server (Phase 0 starts it: `opencode serve`) ----
OPENCODE_HOST=127.0.0.1
OPENCODE_PORT=4096
# Set a strong value on the server; the client reads it to authenticate.
OPENCODE_SERVER_PASSWORD=<set-a-strong-password>

# ---- Harness loop ----
HARNESS_MAX_ITERS=4            # repair-loop cap (handover N=4)
HARNESS_SPEND_CAP_USD=2.00     # abort a run if cumulative cost exceeds this (cost control)
HARNESS_RUNTIME=docker         # docker | kata  (Phase 3 flips this to kata; nothing else changes)
HARNESS_WORKSPACE_ROOT=~/stage3-prework/workspaces   # throwaway per-run workspaces live here
HARNESS_WORKSPACE_IMAGE=poc-prework-workspace:latest # built from docker/Dockerfile.workspace
