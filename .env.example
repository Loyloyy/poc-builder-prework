# ============================================================================
# poc-builder-prework — environment.  Copy to .env and fill in.  .env is GITIGNORED.
#
# ⚠️  This file is COMMITTED — keep it GENERIC. Put real model ids, hostnames, IPs,
#     ports and keys ONLY in the gitignored .env you create on the server.
#
# FORMAT (the loaders are deliberately simple): one KEY=VALUE per line, no spaces
# around '='. Comments go on their OWN line. Fill in every <...> placeholder.
# ============================================================================

# ---- Model endpoint: a DIRECT OpenAI-compatible endpoint. NO proxy (no LiteLLM). ----
# Self-hosted vLLM, or a frontier provider's OpenAI-compatible API (or OpenRouter).
# OpenCode's build engine is pointed here via docker/opencode.example.json; the Phase-0
# smoke test hits it directly. frontier<->vLLM swap (Phase 3) = change the three values below.
#   vLLM     : base http://host:8007/v1            key not-needed
#   frontier : base https://openrouter.ai/api/v1   key <your-key>
MODEL_API_BASE=http://<model-host>:<port>/v1

# vLLM ignores the key, but the OpenAI client wants a non-empty string.
MODEL_API_KEY=not-needed

# Served id EXACTLY as the endpoint exposes it (vLLM ids may have a LEADING SLASH).
HARNESS_MODEL=<served-model-id>

# OpenCode provider key — MUST match the provider key in opencode.json (example uses vllm_api).
OPENCODE_PROVIDER_ID=vllm_api

# OPTIONAL scoped-agent name. Blank = OpenCode's default agent (fine for Phase 1; the workspace
# container is the real sandbox). Set to your agent name (e.g. build) after installing
# docker/opencode-agent.md under OpenCode's agent dir to enforce the scoped permissions.
OPENCODE_AGENT=

# ---- OpenCode headless server (Phase 0 starts it: `opencode serve`) ----
OPENCODE_HOST=127.0.0.1
OPENCODE_PORT=4096

# OPTIONAL — leave BLANK for a normal local (loopback) server; OpenCode needs no auth there.
# Only set a value if you bind the server to a non-loopback address AND have confirmed OpenCode
# supports it (`opencode serve --help`).
OPENCODE_SERVER_PASSWORD=

# ---- Harness loop ----
# repair-loop cap (handover N=4)
HARNESS_MAX_ITERS=4

# abort a run if cumulative cost exceeds this (USD)
HARNESS_SPEND_CAP_USD=2.00

# docker | kata  (Phase 3 flips this to kata; nothing else changes)
HARNESS_RUNTIME=docker

# throwaway per-run workspaces live here
HARNESS_WORKSPACE_ROOT=~/stage3-prework/workspaces

# built from docker/Dockerfile.workspace
HARNESS_WORKSPACE_IMAGE=poc-prework-workspace:latest
